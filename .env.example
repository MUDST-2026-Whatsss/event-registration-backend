# Copy to .env and replace all placeholder secrets before starting containers.

# --- Database -------------------------------------------------------------
POSTGRES_DB=event_registration
POSTGRES_USER=event_app
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_PORT=5432
API_PORT=8080
DB_SCHEMA=public

# To run the local API against a managed PostgreSQL instance, comment the four
# POSTGRES_* entries above and provide the three values below. Then start with
# docker-compose.server.yml. Do not commit real credentials.
# DB_URL=jdbc:postgresql://your-host:5432/event_registration?sslmode=require
# DB_USERNAME=your-managed-database-user
# DB_PASSWORD=your-managed-database-password

# --- Authentication -------------------------------------------------------
# HS256 signing key for the access token. Must decode to at least 32 bytes and
# must be unique per environment. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-openssl-rand-base64-48
JWT_ISSUER=event-registration

# Session lifetimes. Spring duration syntax: 30s, 15m, 1d.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Cookie flags. COOKIE_SECURE must be true anywhere served over HTTPS; the
# `local` profile defaults it to false so plain-HTTP development works.
# Use SameSite=None (with Secure=true) only if the SPA is on another site.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=

# Comma-separated exact origins allowed to send credentialed requests. No
# wildcards: browsers reject "*" once cookies are involved.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Brute-force protection ----------------------------------------------
# Account lockout, stored in PostgreSQL, so it applies across all instances.
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION=15m

# In-memory rate limits, counted per application process.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_IP=10
RATE_LIMIT_LOGIN_PER_ACCOUNT=5
RATE_LIMIT_GLOBAL_PER_IP=300
RATE_LIMIT_WINDOW=1m
# Enable ONLY behind a reverse proxy that overwrites X-Forwarded-For. With it
# on and no such proxy, any client can spoof its IP and bypass the per-IP limit.
RATE_LIMIT_TRUST_FORWARDED_FOR=false

# --- Local development ----------------------------------------------------
# `local` relaxes cookies for plain HTTP. Users are created through the API
# and stored in PostgreSQL; the application does not seed login accounts.
# Deployments must not use this profile.
SPRING_PROFILES_ACTIVE=local
